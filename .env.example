# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Delta Exchange Testnet API Credentials
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Get your testnet keys at: https://testnet.delta.exchange
# Navigate to: Settings → API Keys → Create API Key
DELTA_API_KEY=your_delta_testnet_api_key_here
DELTA_API_SECRET=your_delta_testnet_api_secret_here

# Base URL for the Delta Exchange API (default: testnet India)
# DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Telegram Bot Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. Open Telegram, search for @BotFather
# 2. Send /newbot and follow the prompts to create a bot
# 3. Copy the bot token provided by BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 1. Send a message to your bot first
# 2. Visit https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 3. Find your chat_id in the response JSON
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Database Configuration (PostgreSQL)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# These must match the values in docker-compose.yml
POSTGRES_USER=delta_bot
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=delta_trading
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full connection URL (constructed from the above values)
DATABASE_URL=postgresql://delta_bot:change_me_to_a_strong_password@db:5432/delta_trading

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Trading Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Symbol to trade (BTCUSD perpetual on Delta Exchange India testnet)
TRADING_SYMBOL=BTCUSD

# Candle timeframe for strategy signals
TIMEFRAME=15m

# Starting capital in USDT (testnet simulated balance)
CAPITAL=10000

# Fraction of capital risked per trade (0.02 = 2%)
RISK_PER_TRADE=0.02

# Leverage multiplier
LEVERAGE=5

# Stop-loss percentage (0.015 = 1.5%)
STOP_LOSS_PCT=0.015

# Take-profit percentage (0.03 = 3%)
TAKE_PROFIT_PCT=0.03

# Maximum number of simultaneous open positions
MAX_OPEN_POSITIONS=2

# Daily loss limit as fraction of capital (0.05 = 5%)
DAILY_LOSS_LIMIT=0.05

# Maker fee on Delta testnet (0.0002 = 0.02%)
MAKER_FEE=0.0002

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Strategy Selection
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Available: ema_crossover_rsi, bollinger_mean_revert, macd_momentum
ACTIVE_STRATEGY=ema_crossover_rsi

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Strategy Parameters — EMA Crossover + RSI
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
RSI_PERIOD=14

# RSI filter thresholds for BUY signals
RSI_BUY_LOW=40
RSI_BUY_HIGH=65

# RSI filter thresholds for SELL signals
RSI_SELL_LOW=35
RSI_SELL_HIGH=60

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Strategy Parameters — Bollinger Band Mean Reversion
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BB_PERIOD=20
# BB_STD_DEV=2.0
# BB_RSI_PERIOD=14
# BB_RSI_OVERSOLD=30
# BB_RSI_OVERBOUGHT=70

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Strategy Parameters — MACD Momentum
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MACD_FAST=12
# MACD_SLOW=26
# MACD_SIGNAL=9

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Order Management
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Number of candles to wait before cancelling unfilled entry orders
ORDER_EXPIRY_CANDLES=3

# Maximum API retry attempts on failure
MAX_RETRIES=3

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Logging
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Dashboard
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Real-time live dashboard served by FastAPI inside the bot container
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Kill Switch
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Set to true to immediately cancel all orders, close positions, and shut down
KILL_SWITCH=false
